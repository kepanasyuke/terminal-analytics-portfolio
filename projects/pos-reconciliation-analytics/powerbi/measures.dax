// measures.dax — меры для модели Power BI поверх витрин mart_*.
// Все суммы в витринах в копейках; в отчёт выводим рубли одной мерой-обёрткой,
// чтобы не плодить округления по столбцам.

-- ===== Операции и оборот =====

Операций =
SUM ( mart_partner_daily[txns_cnt] )

Оборот, ₽ =
DIVIDE ( SUM ( mart_partner_daily[amount_kop] ), 100 )

Одобрено, шт =
SUM ( mart_partner_daily[approved_cnt] )

Доля одобренных, % =
DIVIDE ( [Одобрено, шт], [Операций] )

Доля отказов, % =
DIVIDE ( SUM ( mart_partner_daily[declined_cnt] ), [Операций] )

Средний чек, ₽ =
DIVIDE ( [Оборот, ₽], [Одобрено, шт] )

-- ===== Сверка =====

Расхождений, шт =
SUM ( mart_recon_summary[exceptions_cnt] )

Сумма под риском, ₽ =
DIVIDE ( SUM ( mart_recon_summary[amount_at_risk_kop] ), 100 )

Доля расхождений, % =
DIVIDE ( [Расхождений, шт], [Операций] )

Расхождений на 10 000 операций =
DIVIDE ( [Расхождений, шт], [Операций] ) * 10000

Сумма под риском на 1 млн ₽ оборота =
DIVIDE ( [Сумма под риском, ₽], [Оборот, ₽] ) * 1000000

Расхождения P1, шт =
CALCULATE ( [Расхождений, шт], mart_recon_summary[severity] = 1 )

-- ===== Доступность и SLA =====

Устройств в парке =
COUNTROWS ( FILTER ( mart_device_sla, mart_device_sla[status] <> "DECOMMISSIONED" ) )

Доступность парка, % =
CALCULATE (
    AVERAGE ( mart_device_sla[availability_pct] ),
    mart_device_sla[status] <> "DECOMMISSIONED"
)

MTTR, ч =
CALCULATE (
    AVERAGE ( mart_device_sla[mttr_hours] ),
    mart_device_sla[mttr_hours] > 0
)

Инцидентов, шт =
SUM ( mart_device_sla[incidents_cnt] )

Инцидентов на 100 устройств =
DIVIDE ( [Инцидентов, шт], [Устройств в парке] ) * 100

Нарушений SLA, шт =
SUM ( mart_device_sla[sla_breach_cnt] )

Доля нарушений SLA, % =
DIVIDE ( [Нарушений SLA, шт], [Инцидентов, шт] )

Устройств с доступностью ниже 97% =
CALCULATE (
    COUNTROWS ( mart_device_sla ),
    mart_device_sla[availability_pct] < 97,
    mart_device_sla[status] <> "DECOMMISSIONED"
)

Простой, ч =
SUM ( mart_device_sla[downtime_hours] )

-- ===== Динамика (нужен календарь date_dim, связанный с mart_partner_daily[txn_date]) =====

Расхождений, шт (пред. период) =
CALCULATE ( [Расхождений, шт], DATEADD ( date_dim[date], -1, MONTH ) )

Изменение расхождений, % =
VAR Пред = [Расхождений, шт (пред. период)]
RETURN DIVIDE ( [Расхождений, шт] - Пред, Пред )

Доступность, % (скользящие 7 дней) =
CALCULATE (
    [Доступность парка, %],
    DATESINPERIOD ( date_dim[date], MAX ( date_dim[date] ), -7, DAY )
)

-- ===== Ранжирование =====

Ранг партнёра по сумме под риском =
RANKX ( ALL ( mart_partner_daily[partner_id] ), [Сумма под риском, ₽], , DESC )
